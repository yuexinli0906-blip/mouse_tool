{
  "name": "yugutou_tool",
  "type": "module",
  "version": "3.5.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-version.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "dev:app": "node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:card": "node scripts/check-battery-card.cjs",
    "version:sync": "node scripts/sync-version.mjs",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml --lib export_bindings",
    "build:app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri-build.ps1",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri-build.ps1",
    "release:bump": "node scripts/bump-version.mjs",
    "update:dep": "taze major -w && cargo update --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@tanstack/react-router": "^1.170.45",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tauri-store/zustand": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@babel/core": "^8.0.7",
    "@eslint-react/eslint-plugin": "^5.28.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.47",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "tailwindcss": "^4.3.3",
    "taze": "^21.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
