{
  "productName": "yugutou_tool",
  "version": "3.5.0",
  "identifier": "com.wwwj.mousetool",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "yugutou_tool",
        "width": 1200,
        "height": 850,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBEMTI0M0M0MUY4QjYzQ0YKUldUUFk0c2Z4RU1TRFpnNE1DbXZxa1Q3RmpaemJnLzVKaGRrakRtb3Zra0U1MWs1NzBnTjJyVDAK",
      "endpoints": [
        "https://github.com/wjyugutou/mouse_tool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "yugutou_tool"
}
